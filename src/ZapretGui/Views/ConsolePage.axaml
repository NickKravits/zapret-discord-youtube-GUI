<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ZapretGui.ViewModels"
             xmlns:core="using:ZapretGui.Core"
             x:Class="ZapretGui.Views.ConsolePage"
             x:DataType="vm:ConsoleViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="36,28,36,24">
    <TextBlock Classes="PageTitle" Text="Консоль" />

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock Classes="Caption" VerticalAlignment="Center"
                 Text="Журнал работы: вывод winws/nfqws и все действия приложения." />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <CheckBox Content="Автопрокрутка" IsChecked="{Binding AutoScroll}" />
        <Button Command="{Binding CopyAllCommand}" ToolTip.Tip="Скопировать весь журнал">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:SymbolIcon Symbol="Copy" FontSize="14" />
            <TextBlock Text="Копировать" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ClearCommand}" ToolTip.Tip="Очистить журнал">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:SymbolIcon Symbol="Clear" FontSize="14" />
            <TextBlock Text="Очистить" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Classes="Card" Padding="0">
      <ListBox Name="LogList" Classes="Mono" ItemsSource="{Binding Entries}" Background="Transparent" Padding="8,6"
               ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:LogEntry">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding TimeText}" Width="70" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Classes="log"
                         Classes.output="{Binding IsOutput}"
                         Classes.cmd="{Binding IsCommand}"
                         Classes.ok="{Binding IsSuccess}"
                         Classes.warn="{Binding IsWarning}"
                         Classes.err="{Binding IsError}"
                         Text="{Binding Text}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
