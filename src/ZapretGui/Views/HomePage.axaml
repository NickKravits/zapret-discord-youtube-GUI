<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ZapretGui.ViewModels"
             xmlns:core="using:ZapretGui.Core"
             x:Class="ZapretGui.Views.HomePage"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Classes="Page">
      <TextBlock Classes="PageTitle" Text="Главная" />

      <ui:InfoBar IsOpen="{Binding ZapretMissing}" IsClosable="False" Severity="Warning"
                  Title="Файлы zapret не найдены"
                  Message="Скачайте последнюю версию zapret-discord-youtube — она будет сохранена рядом с приложением."
                  Margin="0,0,0,12">
        <ui:InfoBar.ActionButton>
          <Button Classes="accent" Content="Скачать zapret" Command="{Binding DownloadZapretCommand}" />
        </ui:InfoBar.ActionButton>
      </ui:InfoBar>
      <TextBlock Classes="Caption" Text="{Binding DownloadStatus}" IsVisible="{Binding DownloadStatus, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,0,8" />

      <Border Classes="Card" Padding="24,20">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="StatusDot" Classes.on="{Binding IsRunning}">
            <ui:SymbolIcon Symbol="{Binding IsRunning, Converter={x:Static vm:Converters.RunningSymbol}}" FontSize="26" />
          </Border>
          <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding StatusTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Classes="Caption" Text="{Binding StatusSubtitle}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsBusy}" />
            <Button Content="Применить выбранную" Command="{Binding SwitchCommand}" IsVisible="{Binding CanSwitch}" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="accent" MinWidth="130" Height="36" Content="{Binding ToggleText}"
                    Command="{Binding ToggleCommand}" IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Classes="SectionHeader" Text="Стратегия" />
      <ui:SettingsExpander Header="Стратегия обхода"
                           Description="Набор параметров winws из zapret-discord-youtube. Если сайты не открываются — попробуйте другую или запустите тест стратегий."
                           IconSource="Switch">
        <ui:SettingsExpander.Footer>
          <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding SelectedStrategy}" MinWidth="240">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="core:Strategy">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ui:SettingsExpander.Footer>
        <ui:SettingsExpanderItem Content="Аргументы запуска" Description="Пути указаны относительно папки zapret">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Открыть .bat" Command="{Binding OpenStrategyFileCommand}" />
              <Button Content="Обновить список" Command="{Binding ReloadListCommand}" />
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
        <ui:SettingsExpanderItem>
          <SelectableTextBlock Classes="Mono" Text="{Binding ArgsPreview}" TextWrapping="Wrap" />
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <TextBlock Classes="SectionHeader" Text="Быстрые настройки" />
      <ui:SettingsExpander Header="Автозапуск обхода при старте системы"
                           Description="{Binding ServiceDescription}"
                           IconSource="Play">
        <ui:SettingsExpander.Footer>
          <ToggleSwitch IsChecked="{Binding ServiceAutostart}" OnContent="Вкл." OffContent="Выкл." IsEnabled="{Binding !IsBusy}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Comss DNS"
                           Description="Бесплатный DNS от comss.ru — открывает сервисы, недоступные из России (ИИ-сервисы и др.). Подробнее на странице «Comss DNS»."
                           IconSource="Globe">
        <ui:SettingsExpander.Footer>
          <ToggleSwitch IsChecked="{Binding ComssDns}" OnContent="Вкл." OffContent="Выкл." IsEnabled="{Binding !IsBusy}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>

      <ui:SettingsExpander Header="Папка zapret" Description="Стратегии (.bat), списки и бинарные файлы" IconSource="Folder">
        <ui:SettingsExpander.Footer>
          <Button Content="Открыть папку" Command="{Binding OpenZapretFolderCommand}" />
        </ui:SettingsExpander.Footer>
      </ui:SettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
